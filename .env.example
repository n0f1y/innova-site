# Sanity: идентификатор проекта и набор данных. Это не секрет: он виден в адресах запросов сайта.
# Скопируйте файл в .env.local (локально) или задайте те же переменные в настройках хостинга.
# Без этих переменных сайт показывает локальные данные из src/data.
NEXT_PUBLIC_SANITY_PROJECT_ID=ujh0dx6q
NEXT_PUBLIC_SANITY_DATASET=production

# Приём заявок в Telegram (серверные переменные: задаются только на хостинге, в репозиторий не попадают).
# Пока APPLY_ENABLED не равен true, форма на сайте сообщает, что приём не включён.
# APPLY_ENABLED=true
# TELEGRAM_BOT_TOKEN=токен от @BotFather
# TELEGRAM_CHAT_ID=номер чата, куда приходят заявки
